# Public build-time metadata. These values are embedded in the browser bundle.
VITE_APP_NAME=JakIja Learn
VITE_APP_VERSION=0.1.0
# Set to `mobile` only for a mobile-targeted frontend build.
VITE_APP_DEVICE=web

# Leave empty to use the same-origin /api path (recommended behind a reverse proxy).
VITE_API_URL=

# Optional Socket.IO origin. Defaults to VITE_API_URL or the current origin.
VITE_SOCKET_URL=
